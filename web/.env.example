# TX Pilot API server (REST + WebSocket). Used by the dashboard in dev and production builds.
# Vite exposes only variables prefixed with VITE_.
VITE_API_URL=http://localhost:8080

# Optional overrides (defaults derived from VITE_API_URL when unset):
# VITE_API_BASE=http://localhost:8080
# VITE_WS_URL=ws://localhost:8080/v1/ws

# When building for `make build` (served from the Go binary at the same origin),
# leave VITE_API_URL unset — `make build-web` clears it automatically.
