AEGIS_ENV=development
AEGIS_CLUSTER=mainnet-beta
AEGIS_HTTP_ADDR=:8080
AEGIS_POLICY_MODE=SAFE
AEGIS_PUBLIC_API_BASE_URL=http://localhost:8080

SOLANA_RPC_URL=https://fra.rpc.solinfra.dev/sol?api_key=YOUR_RPC_KEY
SOLANA_WS_URL=wss://fra.rpc.solinfra.dev/sol?api_key=YOUR_RPC_KEY
SOLANA_RPC_API_KEY=YOUR_RPC_KEY

YELLOWSTONE_GRPC_URL=fra.grpc.solinfra.dev:443
YELLOWSTONE_GRPC_TOKEN=YOUR_GRPC_TOKEN

SOLINFRA_REST_API_URL=https://fra.api.solinfra.dev?api_key=YOUR_SOLINFRA_REST_KEY
SOLINFRA_REST_API_KEY=YOUR_SOLINFRA_REST_KEY

DATABASE_URL=postgresql://postgres:admin@localhost:5432/aegis_v2?sslmode=disable&search_path=public

OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-4o-mini

JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf/api/v1
JITO_TIP_FLOOR_URL=https://bundles.jito.wtf/api/v1/bundles/tip_floor
JITO_MIN_TIP_LAMPORTS=1000

# Optional for server; required for aegis-cli and integration test signing
AEGIS_KEYPAIR_PATH=./aegis-test-keypair.json

AEGIS_WEBHOOKS_ENABLED=false
AEGIS_WEBHOOK_SIGNING_SECRET=change-me-when-webhooks-enabled
